# API Server Environment Variables

# Gemini API Key for AI-powered commentary generation and predictions
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_MODEL=gemini-1.5-flash

# API-Sports API Key for live sports data (works across all 12 sports)
# Get your key from: https://api-football.com/ (one key works for all sports via api-sports.io)
API_SPORTS_KEY=your_api_sports_key_here

# Alternative: Legacy API-Football key (for backward compatibility)
# Get your key from: https://api-football.com/
API_FOOTBALL_KEY=your_api_football_key_here

# Which host/header style your key belongs to: "rapidapi" (RapidAPI marketplace) 
# or "api-sports" (api-sports.io direct subscription - recommended for multi-sport support)
API_FOOTBALL_PROVIDER=api-sports

# Free-plan daily request cap for API-Sports. The agent hard-stops at this number and reserves
# part of it for the live-games poll loop (see artifacts/api-server/src/lib/sports/core/quota.ts).
# Each sport has its own independent daily quota.
API_SPORTS_DAILY_LIMIT=100
API_FOOTBALL_DAILY_LIMIT=100

# Set to "true" to have Gemini phrase the football agent's answers in natural language.
# The model only ever sees data already fetched from api-sports — it never adds outside facts.
# Leave unset/"false" to use the free, deterministic (no extra Gemini calls) formatter instead.
USE_GEMINI_SYNTHESIS=false

# Server port (default: 8080)
PORT=8080
