# API Server Environment Variables

# Gemini API Key for AI-powered commentary generation
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# API-Sports API Key for live football/soccer data
# Get your key from: https://api-football.com/
API_FOOTBALL_KEY=your_api_football_key_here

# Which host/header style your key belongs to: "rapidapi" (api-football-v1.p.rapidapi.com,
# the RapidAPI marketplace) or "api-sports" (v3.football.api-sports.io, direct subscription).
API_FOOTBALL_PROVIDER=rapidapi

# Free-plan daily request cap for API-Football. The agent hard-stops at this number and reserves
# part of it for the live-fixtures poll loop (see artifacts/api-server/src/lib/football-agent/quota.ts).
API_FOOTBALL_DAILY_LIMIT=100

# Set to "true" to have Gemini phrase the football agent's answers in natural language.
# The model only ever sees data already fetched from api-football — it never adds outside facts.
# Leave unset/"false" to use the free, deterministic (no extra Gemini calls) formatter instead.
USE_GEMINI_SYNTHESIS=false

# Server port (default: 8080)
PORT=8080

# Optional: Add API keys for other sports when expanding beyond soccer
# API_BASKETBALL_KEY=your_api_basketball_key_here
# API_NFL_KEY=your_api_nfl_key_here
